{
    "name": "@worldwideview/wwv-plugin-aviation-weather-hazards",
    "version": "1.0.0",
    "description": "Aviation weather hazards: METAR flight categories and SIGMET convective hazards from the data engine",
    "type": "module",
    "main": "dist/frontend.mjs",
