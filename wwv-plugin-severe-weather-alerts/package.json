{
    "name": "@worldwideview/wwv-plugin-severe-weather-alerts",
    "version": "1.0.0",
    "description": "NWS severe weather alerts (CAP feed, all alert types) from the data engine, rendered as severity-colored, urgency-sized points",
    "type": "module",
    "main": "dist/frontend.mjs",
    "module": "dist/frontend.mjs",
    "types": "src/index.ts",
    "files": [
        "dist",
        "src"
    ],
    "keywords": [
        "worldwideview",
        "worldwideview-plugin",
        "wwv-plugin-severe-weather-alerts",
        "severe-weather",
        "nws",
        "cap",
        "weather-alert",
        "flood-warning",
        "tornado",
        "cesium",
        "globe"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/silvertakana/wwv-plugins.git",
        "directory": "wwv-plugin-severe-weather-alerts"
    },
    "homepage": "https://github.com/silvertakana/worldwideview#readme",
    "bugs": {
        "url": "https://github.com/silvertakana/worldwideview/issues"
    },
    "author": "WorldWideView",
    "license": "ISC",
    "publishConfig": {
        "access": "public"
    },
    "worldwideview": {
        "id": "severe-weather-alerts",
        "type": "data-layer",
        "format": "bundle",
        "category": "natural-disaster",
        "icon": "CloudLightning",
        "dev_entry": "src/index.ts",
        "capabilities": [
            "layer",
            "network:fetch"
        ],
        "ci": {
            "type": "data"
        }
    },
    "scripts": {
        "build": "vite build"
    },
    "peerDependencies": {
        "@worldwideview/wwv-plugin-sdk": "workspace:*",
        "lucide-react": ">=0.576.0"
    }
}