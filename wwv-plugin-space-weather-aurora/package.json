{
    "name": "@worldwideview/wwv-plugin-space-weather-aurora",
    "version": "1.0.0",
    "description": "Aurora oval intensity forecasts from the space weather data engine, rendered as intensity-colored points",
    "type": "module",
    "main": "dist/frontend.mjs",
    "module": "dist/frontend.mjs",
    "types": "src/index.ts",
    "files": [
        "dist",
        "src"
    ],
    "keywords": [
        "worldwideview",
        "worldwideview-plugin",
        "wwv-plugin-space-weather-aurora",
        "aurora",
        "aurora-oval",
        "space-weather",
        "geomagnetic",
        "kp-index",
        "cesium",
        "globe"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/silvertakana/wwv-plugins.git",
        "directory": "wwv-plugin-space-weather-aurora"
    },
    "homepage": "https://github.com/silvertakana/worldwideview#readme",
    "bugs": {
        "url": "https://github.com/silvertakana/worldwideview/issues"
    },
    "author": "WorldWideView",
    "license": "ISC",
    "publishConfig": {
        "access": "public"
    },
    "worldwideview": {
        "id": "space-weather-aurora",
        "type": "data-layer",
        "format": "bundle",
        "category": "space",
        "icon": "CloudSun",
        "dev_entry": "src/index.ts",
        "capabilities": [
            "layer",
            "network:fetch"
        ],
        "ci": {
            "type": "data"
        }
    },
    "scripts": {
        "build": "vite build"
    },
    "peerDependencies": {
        "@worldwideview/wwv-plugin-sdk": "workspace:*",
        "lucide-react": ">=0.576.0"
    }
}