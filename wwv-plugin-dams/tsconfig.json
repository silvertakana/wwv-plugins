{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "jsx": "react-jsx",
        "lib": ["ES2020", "DOM"],
        "noEmit": true,
        "paths": {}
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
