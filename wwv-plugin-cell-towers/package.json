{
    "name": "@worldwideview/wwv-plugin-cell-towers",
    "version": "1.0.0",
    "description": "Global mobile cell tower coverage - curated subset (OpenCelliD)",
    "main": "dist/frontend.mjs",
    "files": [
        "src",
        "data"
    ],
    "keywords": [
        "worldwideview",
        "worldwideview-plugin",
        "wwv-plugin-cell-towers",
        "cell-towers"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/silvertakana/worldwideview-plugins.git",
        "directory": "packages/wwv-plugin-lighthouses"
    },
    "homepage": "https://github.com/silvertakana/worldwideview#readme",
    "bugs": {
        "url": "https://github.com/silvertakana/worldwideview/issues"
    },
    "license": "ISC",
    "author": "WorldWideView",
    "peerDependencies": {
        "@worldwideview/wwv-plugin-sdk": "^1.4.10"
    },
    "worldwideview": {
        "id": "cell-towers",
        "icon": "RadioTower",
        "category": "Infrastructure",
        "format": "bundle",
        "capabilities": [
            "layer"
        ],
        "type": "data-layer",
        "dataFile": "data/data.json",
        "rendering": {
            "defaultColor": "#26c281",
            "iconUrl": "/icons/default.svg"
        },
        "ci": {
            "type": "ui",
            "bundleSizeLimitKb": 15360
        }
    },
    "type": "module",
    "module": "dist/frontend.mjs",
    "scripts": {
        "build": "vite build"
    }
}
