{
    "name": "@worldwideview/wwv-plugin-gdacs-disasters",
    "version": "1.0.0",
    "description": "GDACS (Global Disaster Alert and Coordination System) current disasters from the data engine, rendered as alert-level-colored points",
    "type": "module",
    "main": "dist/frontend.mjs",
    "module": "dist/frontend.mjs",
    "types": "src/index.ts",
    "files": [
        "dist",
        "src"
    ],
    "keywords": [
        "worldwideview",
        "worldwideview-plugin",
        "wwv-plugin-gdacs-disasters",
        "gdacs",
        "disaster",
        "earthquake",
        "tropical-cyclone",
        "flood",
        "wildfire",
        "volcano",
        "drought",
        "cesium",
        "globe"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/silvertakana/wwv-plugins.git",
        "directory": "wwv-plugin-gdacs-disasters"
    },
    "homepage": "https://github.com/silvertakana/worldwideview#readme",
    "bugs": {
        "url": "https://github.com/silvertakana/worldwideview/issues"
    },
    "author": "WorldWideView",
    "license": "ISC",
    "publishConfig": {
        "access": "public"
    },
    "worldwideview": {
        "id": "gdacs-disasters",
        "type": "data-layer",
        "format": "bundle",
        "category": "natural-disaster",
        "icon": "Siren",
        "dev_entry": "src/index.ts",
        "capabilities": [
            "layer",
            "network:fetch"
        ],
        "ci": {
            "type": "data"
        }
    },
    "scripts": {
        "build": "vite build"
    },
    "peerDependencies": {
        "@worldwideview/wwv-plugin-sdk": "workspace:*",
        "lucide-react": ">=0.576.0"
    }
}